{
  "name": "openhiatus",
  "productName": "openHiatus",
  "version": "0.1.5",
  "private": true,
  "description": "Eigenständiger Windows-Sprachassistent mit Pi, mehreren Modellanbietern und persönlichem Gedächtnis",
  "author": "openHiatus contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhiatus/openhiatus.git"
  },
  "homepage": "https://github.com/openhiatus/openhiatus#readme",
  "bugs": {
    "url": "https://github.com/openhiatus/openhiatus/issues"
  },
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "check": "npm run check:architecture && npm run typecheck && npm test",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:chatgpt-ui": "node scripts/chatgpt-ui-check.mjs",
    "test:conversation": "node scripts/conversation-ui-check.mjs --require-context",
    "test:workflow": "node scripts/ui-workflow-check.mjs",
    "test:ipc": "node scripts/ipc-boundary-check.mjs",
    "test:storage-ui": "node scripts/async-storage-ui-check.mjs",
    "test:memory-storage-ui": "node scripts/memory-storage-ui-check.mjs",
    "test:package": "node scripts/package-check.mjs",
    "test:memory-ui": "tsx scripts/m3-ui-check.ts",
    "test:memory-boundary": "tsx --test tests/memory-summary-controller.test.ts",
    "test:memory-readonly": "tsx --test tests/memory-summarizer.test.ts tests/memory-semantic-store.test.ts",
    "bench:storage": "tsx scripts/storage-baseline.ts",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@trycua/cua-driver": "0.22.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
